# Supabase-Zugangsdaten – kopiere diese Datei nach ".env" und trage deine Werte ein.
# Zu finden im Supabase-Dashboard unter: Project Settings → API
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN-ANON-PUBLIC-KEY

# Stripe Price-IDs für den Professional-Plan (Stripe-Dashboard → Product catalog).
# STRIPE_SECRET_KEY und STRIPE_WEBHOOK_SECRET werden NICHT hier gesetzt, sondern als
# Supabase Edge-Function-Secrets: `supabase secrets set STRIPE_SECRET_KEY=...`
VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
VITE_STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...
